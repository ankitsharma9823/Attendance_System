# === Database ===
DATABASE_URL="postgresql://user:password@localhost:5432/attendanceSystem"

# === Biometric Device ===
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370
DEVICE_TIMEOUT=8800
DEVICE_IN_PORT=4000
DEVICE_PASSWORD=0
DEVICE_AUTO_SYNC=true
DEVICE_REALTIME_SYNC=true
DEVICE_STARTUP_SYNC=true
PUNCH_DEBOUNCE_SECONDS=45
SYNC_INTERVAL=180000

# === JWT ===
JWT_SECRET=your-strong-secret-here
JWT_EXPIRES_IN=2h

# === SMTP (Email) ===
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@attendancesystem.com

# === Frontend ===
FRONTEND_URL=http://localhost:3000

# === Attendance ===
ATTENDANCE_TEST_MODE=true
TIMEZONE=Asia/Kathmandu

# === Schedule Defaults (optional) ===
DEFAULT_CHECK_IN_START=07:00
DEFAULT_CHECK_IN_END=10:30
DEFAULT_BREAK_OUT_START=12:30
DEFAULT_BREAK_OUT_END=14:00
DEFAULT_BREAK_IN_START=13:00
DEFAULT_BREAK_IN_END=14:30
DEFAULT_CHECK_OUT_START=17:00
DEFAULT_CHECK_OUT_END=21:00
DEFAULT_MIN_INTERVAL=5
DEFAULT_HALF_DAY=240
DEFAULT_MAX_PUNCHES=4

# === Server ===
PORT=4001
NODE_ENV=development

# === Sync State File (Docker: use /data/.sync-state.json) ===
# SYNC_STATE_FILE=/data/.sync-state.json

# === Admin Setup (for create-admin.ts) ===
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme123
